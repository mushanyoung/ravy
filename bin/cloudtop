#!/bin/sh
# Compatibility name only: Herdr owns SSH, forwarding, reconnects and sessions.
# Usage: cloudtop [host [Herdr options...]] | cloudtop [Herdr options...]
set -eu

case "${1:-}" in
  --mosh|--tmux|--zellij|--ssh)
    printf '%s
' 'cloudtop now uses Herdr native SSH: cloudtop HOST [--session NAME].' >&2
    exit 2
    ;;
esac

if ! command -v herdr >/dev/null 2>&1; then
  printf '%s
' 'herdr not found; install with: mise install herdr (and activate mise shims).' >&2
  exit 127
fi

case "${1:-}" in
  ''|-*) ;;
  *) set -- --remote "$@" ;;
esac

# Herdr's default remote "local" keymap drops custom commands, including our
# home-tab and tab-10 bindings. Use the endpoint's keys unless explicitly chosen.
remote=0
keybindings=0
for arg do
  case "$arg" in
    --) break ;;
    --remote|--remote=*) remote=1 ;;
    --remote-keybindings|--remote-keybindings=*) keybindings=1 ;;
  esac
done
if [ "$remote" = 1 ] && [ "$keybindings" = 0 ]; then
  set -- --remote-keybindings=server "$@"
fi
exec herdr "$@"
